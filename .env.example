# ---------------------------------------------------------------------------
# DirndlTrails environment
# Copy to .env.local for development, or .env.production on the server.
# ---------------------------------------------------------------------------

# Public MapTiler key. Inlined at BUILD time, so it must also be passed as the
# NEXT_PUBLIC_MAPTILER_KEY build arg when building the Docker image.
# Restrict the key to your domain in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=

# Signing secret for the admin session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# scrypt hash of the admin password.
# Generate with: npm run hash-password -- "a long passphrase"
# Keep the generated value byte-for-byte; it uses ":" separators because
# Next.js expands "$" sequences inside .env files.
ADMIN_PASSWORD_HASH=

# Directory that holds hikes.json. Point this at a persistent volume in Docker.
DATA_DIR=./data

# Public origin of the site. Used for CSRF origin checks and canonical URLs.
APP_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional error reporting (leave blank to disable).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Set to "false" only if the app is exposed directly without a reverse proxy.
TRUST_PROXY=true
