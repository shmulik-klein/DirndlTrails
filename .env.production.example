# ---------------------------------------------------------------------------
# Docker deployment configuration.
# Copy to .env.production next to docker-compose.yml, then chmod 600.
# Compose reads it for ${...} interpolation and the app reads it at runtime.
# ---------------------------------------------------------------------------

# Domain Caddy obtains a certificate for (must point at this server).
DOMAIN=trails.example.com

# Address for ACME/Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Public MapTiler key. Inlined at BUILD time: rebuild the image to change it.
# Restrict the key to your domain in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=

# Signing secret for the admin session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# scrypt hash of the admin password.
# Generate with: npm run hash-password -- "a long passphrase"
# Keep the value byte-for-byte; it uses ":" separators because Next.js expands
# "$" sequences inside .env files.
ADMIN_PASSWORD_HASH=

# Public origin. Must match DOMAIN including scheme.
APP_ORIGIN=https://trails.example.com

# Storage inside the container. Keep /data unless you change the compose volume.
DATA_DIR=/data

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set by docker-compose.yml; keep true when running behind Caddy.
TRUST_PROXY=true

# Optional error reporting (leave blank to disable).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
